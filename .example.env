# =============================================================================
# API Keys
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Gemini Models — litellm format requires gemini/ prefix for Google AI Studio
# =============================================================================
# LLM used by the agent and compression pass
GEMINI_MODEL=gemini/gemini-2.5-flash

# Embedding model for node/edge summaries and episode spans
GEMINI_EMBEDDING_MODEL=gemini/gemini-embedding-001

# =============================================================================
# FalkorDB
# =============================================================================
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# GRAPH_NAME=arakne

# =============================================================================
# Memory Budgets (tokens, estimated via tiktoken cl100k_base)
# =============================================================================
# Max tokens for a node's hot log segment before a fence is created
# LOG_TOKEN_BUDGET=2000
# Max tokens for the hot themes block rendered into agent context
# HOT_THEME_TOKEN_BUDGET=250

# =============================================================================
# Storage
# =============================================================================
# TRANSCRIPT_DIR=data/transcripts

# =============================================================================
# Whisper Transcription
# =============================================================================
# Model in litellm format (provider/model)
WHISPER_MODEL=groq/whisper-large-v3-turbo

# Force language (e.g. en, es). Empty = auto-detect.
WHISPER_LANGUAGE=

# Context hint for transcription quality
WHISPER_PROMPT=

# Response format: verbose_json (with timestamps) or json
WHISPER_RESPONSE_FORMAT=verbose_json

# Sampling temperature 0-1. Lower = more deterministic.
WHISPER_TEMPERATURE=0

# =============================================================================
# Reasoning / Thinking (litellm)
# =============================================================================
# Passed as `reasoning_effort` to litellm.completion().
# litellm translates this to Gemini's thinkingConfig.budget_tokens.
# Docs: https://docs.litellm.ai/docs/providers/gemini#usage---thinking--reasoning_content
#
# Values for Gemini 2.5 models:
#   (empty) — no param sent; model decides thinking budget (unlimited, most expensive)
#   none    — budget_tokens=0, thinking disabled (up to 96% cheaper)
#   low     — budget_tokens=1024
#   medium  — budget_tokens=2048
#   high    — budget_tokens=4096
#
# Budget defaults are overridable via env vars:
#   DEFAULT_REASONING_EFFORT_LOW_THINKING_BUDGET=1024
#   DEFAULT_REASONING_EFFORT_MEDIUM_THINKING_BUDGET=2048
#   DEFAULT_REASONING_EFFORT_HIGH_THINKING_BUDGET=4096
#
# Note: reasoning cannot be turned off on Gemini 2.5 Pro models.
REASONING_EFFORT=low

# =============================================================================
# Langfuse setup
# =============================================================================
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="http://localhost:3100"
