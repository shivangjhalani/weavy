# =============================================================================
# API Keys
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Gemini Models — litellm format requires gemini/ prefix for Google AI Studio
# =============================================================================
# LLM used by the agent and compression pass
GEMINI_MODEL=gemini/gemini-2.5-flash

# Embedding model for node/edge summaries and episode spans
GEMINI_EMBEDDING_MODEL=gemini/gemini-embedding-001

# =============================================================================
# FalkorDB
# =============================================================================
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# GRAPH_NAME=lifeos

# =============================================================================
# Storage
# =============================================================================
# TRANSCRIPT_DIR=data/transcripts

# =============================================================================
# Whisper Transcription
# =============================================================================
# Model in litellm format (provider/model)
WHISPER_MODEL=groq/whisper-large-v3-turbo

# Force language (e.g. en, es). Empty = auto-detect.
WHISPER_LANGUAGE=

# Context hint for transcription quality
WHISPER_PROMPT=

# Response format: verbose_json (with timestamps) or json
WHISPER_RESPONSE_FORMAT=verbose_json

# Sampling temperature 0-1. Lower = more deterministic.
WHISPER_TEMPERATURE=0

# =============================================================================
# Agent Reasoning
# =============================================================================
# Controls the reasoning effort for the agent via litellm reasoning_effort param.
#   none   = thinking disabled — fastest, no reasoning
#   low    = ~1024 budget tokens
#   medium = ~2048 budget tokens (default)
#   high   = ~4096 budget tokens
REASONING_EFFORT=medium
